SECRET_KEY=change-me
# DEBUG=1 is the local dev value. Never set it in production; the dev SECRET_KEY is refused when DEBUG is off.
DEBUG=1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/herpath
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production only:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend   (required when DEBUG is off; reset emails would be lost otherwise)
# NUM_PROXIES=1   (Railway puts one proxy in front of gunicorn; leave 0 locally so client-set X-Forwarded-For is ignored)
